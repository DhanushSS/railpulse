{
  "name": "railpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check:db": "node --env-file=.env.local scripts/check-db.mjs",
    "import:observed": "node --env-file=.env.local scripts/import-observed.mjs",
    "setup:mongo": "node --env-file=.env.local scripts/setup-mongo.mjs",
    "mongo:start": "sh scripts/start-mongo.sh",
    "setup:auth": "node --env-file=.env.local scripts/setup-auth.mjs",
    "check:app": "node --env-file=.env.local scripts/check-app.mjs",
    "account:role": "node --env-file=.env.local scripts/set-role.mjs",
    "check:course": "node --env-file=.env.local scripts/check-course.mjs",
    "mongo:console": "node --env-file=.env.local scripts/mongo-console.mjs",
    "setup:incidents": "node --env-file=.env.local scripts/setup-incidents.mjs",
    "check:incidents": "node --env-file=.env.local scripts/check-incidents.mjs"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "typescript": "^5"
  }
}
