# Local PostgreSQL connection. Set your own username/password/host when needed.
DATABASE_URL=postgres:///railpulse
DATA_MODE=demo

# MongoDB for flexible Service Notes documents (local only by default).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=railpulse

# Optional local owner email. Matching registration receives ADMIN. No email verification is provided.
ADMIN_EMAIL=
